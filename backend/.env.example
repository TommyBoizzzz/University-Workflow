PORT=5000

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=university_workflow
DB_USER=postgres
DB_PASSWORD=admin@123

# Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# University schedule settings
UNIVERSITY_TIME_ZONE=Asia/Phnom_Penh

# Optional shared Google Calendar integration.
# Share the university calendar with this service account's email address.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Store the private key in your local .env; use literal \n for line breaks.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Create superadmin for system 
SUPERADMIN_NAME=Administrator
SUPERADMIN_EMAIL=administrator@university.edu
SUPERADMIN_PASSWORD=@Administrator123

JWT_SECRET=university_workflow_super_secret_key_change_this_2026
JWT_EXPIRES_IN=1d
